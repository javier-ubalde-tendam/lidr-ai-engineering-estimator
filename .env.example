# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_RETRIES=1
STRUCTURED_OUTPUT_MAX_RETRIES=2
PROMPT_VERSION=v2

# Sesión 05: Configuración de prompts y límites de conversación. Se usa LLM adicionalpara extraer project metadata
CONVERSATIONAL_PROMPT_VERSION=v4
MAX_CONVERSATION_TURNS=6
MAX_ATTACHMENT_CHARS=60000
METADATA_EXTRACTOR_MODEL=gpt-4o-mini

# Post-sesión 05: compresión del historial (anclas + resumen) y Actor-Critic-Boss
# ANCHOR_DETECTION_MODE: heuristic (regex, sin coste) | llm (clasificador por turno expulsado)
ANCHOR_DETECTION_MODE=heuristic
COMPRESSION_MODEL=gpt-4o-mini
CRITIC_MODEL=gpt-4o-mini
BOSS_MAX_ITERATIONS=3

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Redis / PostgreSQL. Estas URLs son las de ejecución en el host (Windows, `uv run uvicorn ...`).
# Dentro de Docker Compose se sobrescriben solas (redis://redis:6379/0 y el host `postgres`).
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator
# Puertos publicados en el host por Compose (cambia el de Postgres si 5432 está ocupado)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BD exclusiva de los tests de integración (debe terminar en _test)
# TEST_DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator_test

# Embeddings (ingesta, búsqueda y caché semántica): siempre OpenAI text-embedding-3-small (vector(1536)),
# por lo que OPENAI_API_KEY es obligatoria aunque LLM_PROVIDER=anthropic.
# Semantic cache (requires redis-stack-server, not vanilla redis - see docs/sessions/04-form+guardrails.md)
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_LOG_ONLY=False

# Base URL for the API (host). En Docker, el frontend usa http://ai_service:8000 (definido en Compose)
API_BASE_URL=http://localhost:8000