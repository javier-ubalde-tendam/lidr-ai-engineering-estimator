# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_RETRIES=1
STRUCTURED_OUTPUT_MAX_RETRIES=2
PROMPT_VERSION=v2

# Sesión 05: Configuración de prompts y límites de conversación. Se usa LLM adicionalpara extraer project metadata
CONVERSATIONAL_PROMPT_VERSION=v4
MAX_CONVERSATION_TURNS=6
MAX_ATTACHMENT_CHARS=60000
METADATA_EXTRACTOR_MODEL=gpt-4o-mini

# Post-sesión 05: compresión del historial (anclas + resumen) y Actor-Critic-Boss
# ANCHOR_DETECTION_MODE: heuristic (regex, sin coste) | llm (clasificador por turno expulsado)
ANCHOR_DETECTION_MODE=heuristic
COMPRESSION_MODEL=gpt-4o-mini
CRITIC_MODEL=gpt-4o-mini
BOSS_MAX_ITERATIONS=3

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Redis / PostgreSQL. Estas URLs son las de ejecución en el host (Windows, `uv run uvicorn ...`).
# Dentro de Docker Compose se sobrescriben solas (redis://redis:6379/0 y el host `postgres`).
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator
# Puertos publicados en el host por Compose (cambia el de Postgres si 5432 está ocupado)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BD exclusiva de los tests de integración (debe terminar en _test)
# TEST_DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator_test

# Embeddings (ingesta, búsqueda y caché semántica): siempre OpenAI text-embedding-3-small (vector(1536)),
# por lo que OPENAI_API_KEY es obligatoria aunque LLM_PROVIDER=anthropic.
# Semantic cache (requires redis-stack-server, not vanilla redis - see docs/sessions/04-form+guardrails.md)
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_LOG_ONLY=False

# Base URL for the API (host). En Docker, el frontend usa http://ai_service:8000 (definido en Compose)
API_BASE_URL=http://localhost:8000

# Sesión 10: búsqueda híbrida + reranking. Settings se lee al arrancar: para que un cambio en .env
# surta efecto en Docker hay que recrear el contenedor (docker compose up -d --force-recreate ai_service).
# Los campos search_mode/rerank del body de POST /v1/retrieval/search prevalecen sobre estas variables.
RETRIEVAL_TOP_K=10
# Distancia coseno máxima de la rama vectorial (0 = misma dirección)
RETRIEVAL_DISTANCE_THRESHOLD=0.6
# vector | hybrid
RETRIEVAL_SEARCH_MODE=vector
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Recall-then-rerank: se recuperan RETRIEVAL_RECALL_TOP_K candidatos y el cross-encoder deja RERANK_TOP_N
RETRIEVAL_RECALL_TOP_K=50
RERANK_TOP_N=5
RRF_K=60
# or | and (semántica de la rama léxica; ver docs/sessions/10-hybrid-reranking.md)
LEXICAL_MATCH_MODE=or

# Fase 3 (alineación con la Sesión 11): claves de los routers protegidos con la cabecera X-API-Key.
# Vacía (o sin definir) = router deshabilitado: todas las peticiones reciben 401.
# Genera una clave local y ponla en tu `.env`:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RETRIEVAL_API_KEY=
ESTIMATE_API_KEY=

# Estimación RAG (Sesión 9): modelo barato para entender la transcripción, modelo fuerte para generar.
# Los *_MODEL de esta sección y de las siguientes pueden sobrescribirse en caliente con
# PUT /api/v1/config/models (Redis); aquí van los valores por defecto.
REFORMULATION_MODEL=gpt-5-mini
GENERATION_MODEL=gpt-5
# minimal | low | medium | high
GENERATION_REASONING_EFFORT=medium
# Tope de tokens (razonamiento + salida) de las llamadas estructuradas RAG
GENERATION_MAX_TOKENS=64000
# Presupuesto de tokens del contexto <source> ensamblado
MAX_CONTEXT_TOKENS=16384
# Modelos seleccionables en runtime (JSON); se filtran por las API keys configuradas
# AVAILABLE_MODELS=["gpt-4o-mini","gpt-4o","gpt-5","gpt-5-mini","claude-haiku-4-5-20251001","claude-sonnet-4-5"]
# Caché de idempotencia de POST /v1/estimate/from-transcript (segundos; 24 h)
IDEMPOTENCY_TTL=86400

# Sesión 10 live: retrieval avanzado multi-índice (cada etapa se activa por separado)
RETRIEVAL_ROUTING_ENABLED=true
QUERY_TRANSFORM_ENABLED=true
# Re-ponderación temporal suave: apágala hasta tener evidencia de que mejora
TEMPORAL_DECAY_ENABLED=false
ROUTER_MODEL=gpt-4o-mini
QUERY_TRANSFORM_MODEL=gpt-4o-mini
# peso = 0.5 ** (antigüedad / vida_media); ~2,5 años porque los presupuestos envejecen despacio
TEMPORAL_DECAY_HALF_LIFE_DAYS=900
QUERY_MAX_SUBQUERIES=4
ROUTER_MAX_TARGETS=3
# Horas por tarea (POST /v1/estimate/tasks/hours): vecinos por tarea y distancia coseno máxima;
# una tarea cuyo vecino más cercano esté más lejos no recibe horas (bandera roja)
TASK_HOURS_TOP_K=5
TASK_HOURS_DISTANCE_THRESHOLD=0.45

# Sesión 11 live: calidad de la generación
# Puerta anti-alucinación: comprueba que cada cifra citada está respaldada por su chunk
HALLUCINATION_GATE_ENABLED=true
HALLUCINATION_JUDGE_MODEL=gpt-5-mini
# Una línea cuyas horas se desvíen del ancla histórica más que esta fracción se degrada
HALLUCINATION_NUMERIC_TOLERANCE=0.5
# Aumento de los chunks recuperados ANTES de generar: compresión + reordenación (bordes primero)
AUGMENTATION_ENABLED=true
AUGMENTATION_COMPRESS=true
AUGMENTATION_REORDER=true
AUGMENTATION_MODEL=gpt-5-mini
# Síntesis: si las fuentes discrepan más que este coeficiente de variación, se devuelve un rango de horas
SYNTHESIS_ENABLED=true
SYNTHESIS_CONTRADICTION_THRESHOLD=0.35

# Session 12: agent with a manual loop over the raw OpenAI Responses API (POST /v1/estimate/agent).
# It needs OPENAI_API_KEY (OpenAI specifically) and ESTIMATE_API_KEY. Each run makes several paid calls:
# debug with gpt-5-mini + minimal, run the real thing with gpt-5 + medium.
AGENT_MODEL=gpt-5
# minimal | low | medium | high
AGENT_REASONING_EFFORT=medium
# Maximum model turns per run (each turn can execute several tool calls in parallel)
AGENT_MAX_ITERATIONS=10
# Historical tasks returned per search_budgets call and max cosine distance
AGENT_SEARCH_TOP_K=5
AGENT_SEARCH_DISTANCE_THRESHOLD=0.6
# Session 13: LangGraph estimation workflow (POST /v1/estimate/graph) with a Postgres checkpointer
# (same database as the rest; tables are created at startup). If Postgres is unreachable at startup
# the service still boots and the endpoint answers 503. false = do not even try
GRAPH_ENABLED=true
GRAPH_EXTRACTION_MODEL=gpt-4o-mini
GRAPH_GENERATION_MODEL=gpt-5-mini
# Logfire traces (one span per graph node). Empty = no export. Put a WRITE token here, only in your
# local .env, never in git
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=ai-service

# Sesión 7 live: estrategias de chunking que llaman a un LLM (POST /embeddings/compare, de pago)
PROPOSITIONAL_CHUNKER_MODEL=gpt-4o-mini
CONTEXTUAL_CHUNKER_MODEL=claude-sonnet-4-5

# Session 6: offline ingestion (POST /api/v1/ingestion/runs). Placeholders only: nothing secret here
# YAML catalog of audited data sources (loaded at startup; a broken catalog is logged, not fatal)
CATALOG_PATH=data/catalog/catalog.yaml
# Root the catalog `location` entries are resolved against
INGESTION_DATA_ROOT=data/seed
# Spanish spaCy model of the Presidio analyzer. It is a separate wheel, not on PyPI: see the
# README (local install) and the INSTALL_SPACY_MODEL build arg of the Dockerfile
PRESIDIO_SPACY_MODEL=es_core_news_md
PSEUDONYM_FAKER_LOCALE=es_ES
# HMAC salt of pseudonym_mappings.original_hash. This value is a DEV PLACEHOLDER (the app logs a
# warning at startup while it is in use): put a long random secret of your own in your .env.
# Rotating it orphans the existing mappings
PSEUDONYM_HASH_SALT=dev-only-insecure-salt-change-me