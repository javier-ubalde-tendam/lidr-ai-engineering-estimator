# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_RETRIES=1
STRUCTURED_OUTPUT_MAX_RETRIES=2
PROMPT_VERSION=v2
CONVERSATIONAL_PROMPT_VERSION=v3
MAX_CONVERSATION_TURNS=6
MAX_ATTACHMENT_CHARS=60000
METADATA_EXTRACTOR_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Semantic cache (requires redis-stack-server, not vanilla redis - see docs/sessions/04-form+guardrails.md)
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_LOG_ONLY=False

# Base URL for the API
API_BASE_URL=http://localhost:8000