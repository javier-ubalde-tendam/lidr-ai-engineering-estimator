# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_RETRIES=1

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Base URL for the API
API_BASE_URL=http://localhost:8000