<example>
<project_description>
A data pipeline to consolidate sales data from five regional CRMs into a single warehouse. Nightly batch ingestion, schema normalisation, deduplication of customer records, and a dashboard refreshed every morning for the commercial team. No real-time requirement.
</project_description>
<estimation>
{
  "summary": "Nightly consolidation of five regional CRMs into one warehouse, with deduplicated customers and a morning dashboard. Team: 1 data engineer, 1 backend developer (part-time) and 1 analytics engineer, delivered in 14 weeks.",
  "confidence_pct": 70,
  "phases": [
    {"name": "Discovery", "duration_weeks": 2, "cost_eur": 4000, "summary": "Map the schemas of the five CRMs and agree the target warehouse model."},
    {"name": "Design", "duration_weeks": 2, "cost_eur": 4500, "summary": "Design the ingestion flow, the normalised schema and the deduplication rules."},
    {"name": "Implementation", "duration_weeks": 7, "cost_eur": 24500, "summary": "Build the nightly ingestion, the normalisation and deduplication jobs and the dashboard."},
    {"name": "QA", "duration_weeks": 2, "cost_eur": 5000, "summary": "Reconcile warehouse totals against each CRM and test failure recovery."},
    {"name": "Launch", "duration_weeks": 1, "cost_eur": 2000, "summary": "Deploy to production, schedule the batches and hand over to the commercial team."}
  ],
  "total_duration_weeks": 14,
  "total_cost_eur": 40000
}
</estimation>
</example>

